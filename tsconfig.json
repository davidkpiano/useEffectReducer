{
  "include": ["src"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true
  }
}
