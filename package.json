  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "author": "David Khourshid",
  "sideEffects": false,
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/react": "^16.3.3",
